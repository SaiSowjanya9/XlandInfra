# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=customer_portal
DB_PORT=3306

# Server Configuration
PORT=5000
NODE_ENV=development

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# JWT Configuration
JWT_SECRET=your-secure-secret-key
JWT_EXPIRES_IN=24h

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
NOTIFICATION_EMAIL=ssmspy@gmail.com

# Frontend URL (for activation links)
FRONTEND_URL=http://localhost:3000

# Demo Mode Configuration (set to true only for development/demo environments)
# IMPORTANT: Never enable demo mode in production!
DEMO_MODE=false
# Generate hash with: node -e "console.log(require('bcryptjs').hashSync('your-demo-password', 10))"
DEMO_PASSWORD_HASH=
