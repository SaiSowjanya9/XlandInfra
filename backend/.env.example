# Database Configuration

# Set NODE_ENV to 'development' for local DB or 'production' for Railway DB

# Local Database (used when NODE_ENV=development)
LOCAL_DB_HOST=localhost
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=your_local_password
LOCAL_DB_NAME=customer_portal_local
LOCAL_DB_PORT=3306

# Railway Database (used when NODE_ENV=production)
DB_HOST=kodama.proxy.rlwy.net
DB_USER=root
DB_PASSWORD=your_railway_password
DB_NAME=railway
DB_PORT=30074
DB_SSL=true

# Server Configuration
PORT=5000
NODE_ENV=development

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# =============================================================================
# JWT Configuration (CRITICAL SECURITY)
# =============================================================================
# IMPORTANT: JWT_SECRET is REQUIRED in production! Server will crash without it.
# Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 64 characters long for security
JWT_SECRET=your-64-character-minimum-secure-random-secret-key-here
JWT_EXPIRES_IN=24h

# Email Configuration (Hostinger SMTP - Production)
# Use info@xlandinfra.com for all outgoing emails
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=info@xlandinfra.com
EMAIL_PASS=your-hostinger-email-password
NOTIFICATION_EMAIL=info@xlandinfra.com
# Contact form sender (use noreply@xlandinfra.com to avoid "Note to self" in Outlook)
CONTACT_FORM_SENDER_EMAIL=noreply@xlandinfra.com

# Frontend URL (for customer activation links)
# Production: https://xlandinfra.com
FRONTEND_URL=http://localhost:3000

# Admin Portal URL (for staff/employee activation links)
# Production: https://admin.xlandinfra.com
ADMIN_PORTAL_URL=http://localhost:5174

# Demo Mode Configuration (set to true only for development/demo environments)
# IMPORTANT: Never enable demo mode in production!
DEMO_MODE=false
# Generate hash with: node -e "console.log(require('bcryptjs').hashSync('your-demo-password', 10))"
DEMO_PASSWORD_HASH=

# =============================================================================
# Razorpay Payment Gateway Configuration
# =============================================================================
# Get your API keys from: https://dashboard.razorpay.com/app/keys
# Test Mode: Use rzp_test_* keys for development
# Live Mode: Use rzp_live_* keys for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret from: Dashboard > Settings > Webhooks > Create New Webhook
# Webhook URL: https://api.xlandinfra.com/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# SMTP Configuration (for sending payment link emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=info@xlandinfra.com
SMTP_PASS=your-email-password

# =============================================================================
# PRODUCTION SECURITY CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
#
# 1. NODE_ENV=production (enables strict security checks)
# 2. JWT_SECRET is a unique, cryptographically secure 64+ char string
# 3. DEMO_MODE=false (or remove entirely)
# 4. All database passwords are strong and unique
# 5. Email credentials are App Passwords (not main account passwords)
# 6. HTTPS is configured via Nginx + Certbot
# 7. UFW firewall is enabled on VPS (only allow SSH, HTTP, HTTPS)
# 8. fail2ban is installed and configured
# 9. SSH root login is disabled
# 10. Regular database backups are scheduled
#
# Security features enabled in this application:
# - Helmet.js HTTP security headers
# - Rate limiting (100 req/15min general, 5 req/15min for login)
# - XSS sanitization on all inputs
# - HTTP Parameter Pollution (HPP) prevention
# - CORS whitelist (only allowed origins)
# - Request body size limits (10KB)
# - bcrypt password hashing (salt rounds: 10)
# - JWT authentication with expiry
# - Role-based access control (RBAC)
# =============================================================================
