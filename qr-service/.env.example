# XLAND INFRA QR Service Configuration
# Copy this file to .env and update with your values

# Server Configuration
QR_SERVICE_PORT=3500
NODE_ENV=production

# Database Configuration (same as main backend)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=customer_portal
DB_PORT=3306

# Security
IP_SALT=your-random-salt-for-ip-hashing

# Optional: Redis for distributed rate limiting (cluster mode)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
