# API URL Configuration
# Development: Leave empty (Vite proxy handles /api/* requests)
# Production: Leave empty (Nginx proxies /api/* to backend)
VITE_API_URL=

# App name displayed in the UI
VITE_APP_NAME=XLand Infra Admin

# Google Maps API Key (required for location picker and map display)
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API, Places API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=
